HEADS AA

START ## START ## SR

START *= START *= DD
START *_ GO_UP *_ UU
START *| CLEAN_DOWN *| RR
GO_UP *= GO_UP *= UU
GO_UP *_ NEW_CLMN *_ RR
NEW_CLMN __ START __ DD

CLEAN_DOWN |* CLEAN_DOWN |* DD
CLEAN_DOWN _* CLEAN_UP _* UU
CLEAN_DOWN == CLEAN_RIGHT |_ SR
CLEAN_DOWN =| CLEAN_DOWN |_ DD
CLEAN_UP |_ CLEAN_UP |_ UU
CLEAN_UP =| CLEAN_UP |_ UU
CLEAN_UP == CLEAN_RIGHT |_ SR
CLEAN_RIGHT |= CLEAN_RIGHT |_ SR
CLEAN_RIGHT || BRING_BACK |_ SL
CLEAN_RIGHT _| BRING_BACK __ LL
CLEAN_RIGHT _= CLEAN_RIGHT __ RR

BRING_BACK |_ BRING_BACK |_ SL
BRING_BACK || CLEAN_DOWN || SR
CLEAN_UP __ STOP __ DD
